{
  "state": {
    "directory": "wiki"
  },
  "ingest": {
    "max_pages_per_ingest": 12,
    "page_max_words": 600,
    "require_citations": true
  },
  "query": {
    "pages_slice": 8,
    "context_tokens": 4000
  },
  "lint": {
    "stale_after_days": 90,
    "auto_fix": "index-and-links"
  },
  "schema": {
    "page_types": [
      "concept",
      "decision",
      "component",
      "reference",
      "howto"
    ]
  }
}
