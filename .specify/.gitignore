# Machine-local Spec Kit state — not meant to be shared.
# Managed by the Specify CLI; safe to edit (your changes are preserved on refresh).

# Local pointer to the current feature directory. Rewritten every time you
# switch features, so it is per-checkout state rather than something to share.
feature.json

# Per-machine extension config overrides.
extensions/*/local-config.yml

# Local catalog caches and installed release snapshots. Keep project-specific
# extension configuration visible for review.
.workflow-install.lock
bundle-records.json
extensions/.cache/
workflows/.cache/
extensions/flow-feedback/
extensions/flow-roadmap/*
!extensions/flow-roadmap/roadmap-config.yml
extensions/flow-wiki/*
!extensions/flow-wiki/flow-wiki-config.yml
workflows/speckit-flow-*/
